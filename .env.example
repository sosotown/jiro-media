# supacms APIキー。サーバーサイド(Route Handler/Server Component)からのみ参照される。
# クライアントバンドルに絶対に含めないこと(NEXT_PUBLIC_ プレフィックスを付けない)。
SUPACMS_API_KEY=

# 本番公開URL。OGP/canonical/sitemap生成に使用する。
NEXT_PUBLIC_SITE_URL=https://example.com

# Cloudflare Web Analyticsのビーコントークン(公開情報。クライアントに埋め込まれる)。
# Cloudflareダッシュボード: Analytics & Logs > Web Analytics で発行する。
NEXT_PUBLIC_CF_BEACON_TOKEN=

# 人気記事ランキング取得用(未設定でもビルドは失敗せず、セクションが非表示になるだけ)。
# CLOUDFLARE_API_TOKENはAccount Analytics Read権限のトークン。サーバーサイドのみで使用。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
